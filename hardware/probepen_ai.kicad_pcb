  (gr_arc (start 24.000 57.500) (mid 21.172 56.328) (end 20.000 53.500) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_arc (start 150.500 42.500) (mid 151.561 42.939) (end 152.000 44.000) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_arc (start 152.000 56.000) (mid 151.561 57.061) (end 150.500 57.500) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))

