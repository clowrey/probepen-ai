      (layer "In1.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 2" (type "core") (thickness 1.065) (material "FR4") (epsilon_r 4.6))
      (layer "In2.Cu" (type "copper") (thickness 0.0175))
      (layer "dielectric 3" (type "prepreg") (thickness 0.2104) (material "FR4") (epsilon_r 4.4))
      (layer "B.Cu" (type "copper") (thickness 0.035))
      (layer "B.Mask" (type "Bottom Solder Mask") (thickness 0.01))
      (layer "B.Paste" (type "Bottom Solder Paste"))
      (layer "B.SilkS" (type "Bottom Silk Screen"))
      (copper_finish "ENIG")
    )
    (pad_to_mask_clearance 0)
    (aux_axis_origin 20.000 50.000)
    (grid_origin 20.000 50.000)
  )
  (net 0 "")

  (gr_line (start 24.000 42.500) (end 150.500 42.500) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
  (gr_line (start 152.000 44.000) (end 152.000 56.000) (stroke (width 0.15) (type solid)) (layer "Edge.Cuts"))
