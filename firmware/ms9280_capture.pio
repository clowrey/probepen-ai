; MS9280 10-bit parallel ADC capture @ 35 MSPS (RP2354B PIO0)
; Hardware pins (matches hw/design.py GPIO):
;   IN base  = GPIO5..GPIO14 (ADC_D9..ADC_D0, 10 bits, bit-reversed in software)
;   Sideset  = GPIO3         (ADC_CLK, active clock to MS9280)
; Runs 1 sample every 2 PIO cycles: sysclk=140 MHz (clkdiv=2.0) -> 35 MSPS.

.program ms9280_capture
.side_set 1

.wrap_target
    nop             side 1    ; Clock rising edge: latches previous ADC word internally
    in pins, 10     side 0    ; Clock falling edge: sample 10-bit bus into ISR (autopush 30 bits = 3 samples/word)
.wrap

% c-sdk {
#include "hardware/clocks.h"
#include "hardware/pio.h"

static inline void ms9280_capture_program_init(PIO pio, uint sm, uint offset, float clkdiv) {
    pio_sm_config c = ms9280_capture_program_get_default_config(offset);
    for (uint pin = 5; pin < 15; ++pin) {
        pio_gpio_init(pio, pin);
    }
    pio_gpio_init(pio, 3);
    pio_sm_set_consecutive_pindirs(pio, sm, 5, 10, false);
    pio_sm_set_consecutive_pindirs(pio, sm, 3, 1, true);
    sm_config_set_in_pins(&c, 5);
    sm_config_set_sideset_pins(&c, 3);
    sm_config_set_in_shift(&c, false, true, 30);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&c, clkdiv);
    pio_sm_init(pio, sm, offset, &c);
}
%}
