(version 1)
# Generated by hw/gen_pcb.py. JLCPCB JLC04161H-7628 4-layer manufacturing rules.
(rule "JLC 4-layer baseline"
  # JLC 4-layer 3.5-mil (0.092mm; 5-mil 0.127mm nominal)
  (constraint clearance (min 0.092mm))
  (constraint track_width (min 0.092mm))
  (constraint via_diameter (min 0.45mm))
  (constraint via_drill (min 0.25mm))
  # JLC: no via surcharge for a 0.2 or 0.25 mm hole once the pad is 0.45 mm or more: 0.10 mm ring
  (constraint annular_width (min 0.1mm))
  (constraint hole_clearance (min 0.25mm))
  (constraint edge_clearance (min 0.30mm))
  (constraint silk_clearance (min 0.15mm))
)
(rule "MCU core"
  # Inside the RP2354B pad ring: the +1V1 pour on top (CellKeeper layout), the exposed pad and its ground vias,
  # ground on the inner layers and the +3V3 pour on the bottom that feeds the IOVDD pins. Only supply and
  # ground tracks there, on any layer; other nets may pass by via.
  (constraint disallow track)
  (condition "A.intersectsArea('mcu_core_b') && A.NetName != '/+3V3_DIG' && A.NetName != '/+1V1_CORE' && A.NetName != '/GND'")
)
(rule "POWER netclass"
  (condition "A.NetClass == 'POWER'")
  (constraint track_width (min 0.12mm))
)
(rule "USB diff pair"
  (condition "A.NetClass == 'USB'")
  (constraint track_width (min 0.12mm))
)
(rule "HV divider to ground and LV"
  (condition "(A.NetName == '/CH1_TIP' || A.NetName == '/CH1_HV_MID' || A.NetName == '/CH2_TIP' || A.NetName == '/CH2_HV_MID') && (B.NetName != A.NetName)")
  (constraint clearance (min 0.40mm))
)
